# Server-only settings. Copy this file to .env.
APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobfinder
DATABASE_POOL_MAX=10
DATABASE_LOGGING=false

# Generate a random secret of at least 32 characters before signing up.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional. Each service can be enabled independently.
BRAVE_SEARCH_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional stable random secret (32+ characters) for personal Gemini keys.
# If unset, key encryption derives from BETTER_AUTH_SECRET.
SETTINGS_ENCRYPTION_SECRET=
